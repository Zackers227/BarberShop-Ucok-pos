# Server Configuration
PORT=3001
NODE_ENV=development

# Database - SQLite (Local Development)
DB_PATH=./database/pos.db

# Database - PostgreSQL (Online/Production)
# Uncomment dan isi jika pakai PostgreSQL
# DATABASE_URL=postgresql://user:password@host:5432/database
# atau
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=ininotes_pos
# DB_USER=postgres
# DB_PASSWORD=yourpassword
# DB_SSL=false

# JWT Secret
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=24h

# Default Admin
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

# Business Info
BUSINESS_NAME=IniNotes Barbershop
BUSINESS_ADDRESS=Jl. Raya Barbershop No. 123
BUSINESS_PHONE=+62 812-3456-7890
BUSINESS_LOGO=logo.png

# Printer Settings
PRINTER_WIDTH=32
PRINTER_TYPE=thermal
